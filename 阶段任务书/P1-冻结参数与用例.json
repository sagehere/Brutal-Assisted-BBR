  "assist": {
    "allowed_bbr_phase": [
      "ProbeBW.Refill",
      "ProbeBW.Up",
      "ProbeBW.Cruise"
    ],
    "max_relative_rate_gain": 1.1,
    "weight_step_per_bbr_round": 0.05,
    "max_duration_ms": 300,
