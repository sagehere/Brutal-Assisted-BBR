    "budget_accounting": "pre-debit generated assist datagram bytes; no refund on socket failure"
  },
  "guards": {
    "soft_queue_delay_min_ms": 10,
    "soft_queue_delay_min_rtt_ratio": 0.25,
    "hard_queue_delay_min_ms": 20,
    "hard_queue_delay_min_rtt_ratio": 0.5,
    "sample_max_age_rounds": 1,
    "minimum_efficiency_increment_byte_per_s": 1000000
  },
  "backoff": {
    "base_ms": 30000,
    "maximum_ms": 600000,
    "failure_counter_scope": "connection-path identity; a target, idle, mode, or transient RTT change never clears it"
  },
  "telemetry": {
    "ring_entries_per_connection": 4096,
    "maximum_serialized_bytes_per_minute": 1048576,
    "cpu_p95_overhead_ratio": 0.02,
