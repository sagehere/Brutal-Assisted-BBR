    "io_adapter": "tokio-quiche at the same frozen upstream commit for socket-success telemetry"
  },
  "units": {
    "rate": "byte/s",
    "window": "byte",
    "time": "ms"
  },
  "target": {
    "minimum_nonzero_byte_per_s": 1000000,
    "maximum_byte_per_s": 125000000,
    "enter_ratio": 0.8,
    "exit_ratio": 0.9
