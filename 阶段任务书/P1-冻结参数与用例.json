    "actual_sent_accounting": "socket/GSO successful returned bytes only"
  },
  "acceptance": {
    "primary": "500->100->500 Mbps, Target=200 Mbps; time to 0.9T improves by >=20%",
    "secondary": "500 Mbps, Target=200 Mbps, 1% and 5% random loss",
    "normal_goodput_regression_ratio": 0.03,
    "send_cost_increase_ratio": 0.1,
    "fairness_competitor_loss_ratio": 0.1,
    "minimum_runs_per_key_scenario": 10
  },
  "capabilities": {
    "bbr_is_in_recovery": "not_used",
    "pto_event": "supported via recovery on_loss_detection_timeout",
    "loss_event": "supported via recovery loss detection",
