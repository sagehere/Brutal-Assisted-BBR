diff --git a/quiche/src/recovery/gcongestion/pacer.rs b/quiche/src/recovery/gcongestion/pacer.rs
--- a/quiche/src/recovery/gcongestion/pacer.rs
+++ b/quiche/src/recovery/gcongestion/pacer.rs
@@ -101,6 +101,24 @@ impl Pacer {
     pub(crate) fn babr_observe_snapshot(&self) -> BabrObserveSnapshot {
         self.sender.babr_observe_snapshot()
     }
+
+    /// Resolve one already-authorized BABR-Lite pacing decision at the final
+    /// output layer without mutating BBRv2 state.
+    ///
+    /// The normal Off/Observe path does not call this helper, so the existing
+    /// [`pacing_rate`] hot path remains byte-for-byte unchanged. Host
+    /// `max_pacing_rate` is still the final clamp.
+    pub(crate) fn babr_lite_effective_pacing_rate(
+        &self, requested_rate_bytes_per_second: u64,
+    ) -> Bandwidth {
+        let requested =
+            Bandwidth::from_bytes_per_second(requested_rate_bytes_per_second);
+
+        match self.max_pacing_rate {
+            Some(rate) if self.enabled => rate.min(requested),
+            _ => requested,
+        }
+    }
 
     pub fn on_packet_sent(
         &mut self, sent_time: Instant, bytes_in_flight: usize,
@@ -298,3 +316,60 @@ impl Pacer {
         !self.pacing_limited && self.sender.is_cwnd_limited(bytes_in_flight)
     }
 }
+
+#[cfg(test)]
+mod babr_lite_output_tests {
+    use std::time::Duration;
+
+    use super::*;
+
+    fn sender() -> BBRv2 {
+        BBRv2::new(
+            10,
+            10_000,
+            1200,
+            Duration::from_millis(100),
+            None,
+        )
+    }
+
+    fn rtt_stats() -> RttStats {
+        RttStats::new(
+            Duration::from_millis(100),
+            Duration::from_millis(25),
+        )
+    }
+
+    #[test]
+    fn babr_lite_bridge_leaves_normal_pacer_path_unchanged() {
+        let rtt = rtt_stats();
+        let pacer = Pacer::new(true, sender(), None);
+        let baseline = pacer.pacing_rate(0, &rtt).to_bytes_per_second();
+        let baseline_cwnd = pacer.get_congestion_window();
+        let requested = baseline.saturating_mul(11) / 10;
+
+        assert_eq!(
+            pacer.babr_lite_effective_pacing_rate(requested)
+                .to_bytes_per_second(),
+            requested
+        );
+        assert_eq!(
+            pacer.pacing_rate(0, &rtt).to_bytes_per_second(),
+            baseline
+        );
+        assert_eq!(pacer.get_congestion_window(), baseline_cwnd);
+    }
+
+    #[test]
+    fn host_max_rate_is_final_clamp_for_lite_bridge() {
+        let host_max = Bandwidth::from_bytes_per_second(123_456);
+        let pacer = Pacer::new(true, sender(), Some(host_max));
+        let baseline_cwnd = pacer.get_congestion_window();
+
+        assert_eq!(
+            pacer.babr_lite_effective_pacing_rate(10_000_000),
+            host_max
+        );
+        assert_eq!(pacer.get_congestion_window(), baseline_cwnd);
+    }
+}
