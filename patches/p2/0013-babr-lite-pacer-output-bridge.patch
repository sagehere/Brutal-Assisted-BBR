+#[cfg(test)]
+mod babr_lite_output_tests {
+    use std::time::Duration;
+
+    use super::*;
+
+    fn sender() -> BBRv2 {
+        BBRv2::new(
+            10,
+            10_000,
+            1200,
+            Duration::from_millis(100),
+            None,
+        )
+    }
+
+    fn rtt_stats() -> RttStats {
+        RttStats::new(
+            Duration::from_millis(100),
+            Duration::from_millis(25),
+        )
+    }
+
+    #[test]
+    fn babr_lite_override_changes_only_final_pacing_output() {
+        let rtt = rtt_stats();
+        let mut pacer = Pacer::new(true, sender(), None);
+        let baseline = pacer.pacing_rate(0, &rtt).to_bytes_per_second();
+        let baseline_cwnd = pacer.get_congestion_window();
+        let requested = baseline.saturating_mul(11) / 10;
+
+        pacer.babr_apply_lite_rate_override(Some(requested));
+
+        assert_eq!(
+            pacer.pacing_rate(0, &rtt).to_bytes_per_second(),
+            requested
+        );
+        assert_eq!(pacer.get_congestion_window(), baseline_cwnd);
+
+        pacer.babr_apply_lite_rate_override(None);
+        assert_eq!(
+            pacer.pacing_rate(0, &rtt).to_bytes_per_second(),
+            baseline
+        );
+        assert_eq!(pacer.get_congestion_window(), baseline_cwnd);
+    }
+
+    #[test]
+    fn host_max_rate_remains_final_clamp_over_lite_override() {
+        let rtt = rtt_stats();
+        let host_max = Bandwidth::from_bytes_per_second(123_456);
+        let mut pacer = Pacer::new(true, sender(), Some(host_max));
+        let baseline_cwnd = pacer.get_congestion_window();
+
+        pacer.babr_apply_lite_rate_override(Some(10_000_000));
+
+        assert_eq!(pacer.pacing_rate(0, &rtt), host_max);
+        assert_eq!(pacer.get_congestion_window(), baseline_cwnd);
+    }
+}
