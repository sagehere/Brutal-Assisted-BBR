+    #[test]
+    fn loss_enters_backoff_and_blocks_reentry_until_deadline() {
+        let now = Instant::now();
+        let mut c = controller(BabrMode::Lite);
+        let mut loss = input(now);
+        loss.loss_detected = true;
+
+        let failed = c.on_round(loss);
+        assert_eq!(failed.shadow_reason, BabrReasonCode::LossDetected);
+        assert_eq!(failed.state, BabrLiteState::AssistBackoff);
+        assert_eq!(c.failure_count, 1);
+        assert_eq!(
+            c.backoff_deadline,
+            Some(now + Duration::from_millis(BACKOFF_BASE_MS)),
+        );
+
+        let blocked = c.on_round(input(now + Duration::from_secs(29)));
+        assert_eq!(blocked.shadow_reason, BabrReasonCode::BackoffActive);
+        assert_eq!(blocked.state, BabrLiteState::AssistBackoff);
+        assert_eq!(blocked.weight_steps, 0);
+
+        let resumed = c.on_round(input(now + Duration::from_secs(30)));
+        assert_eq!(resumed.shadow_reason, BabrReasonCode::BoundedProbe);
+        assert_eq!(resumed.state, BabrLiteState::Assist);
+        assert_eq!(resumed.weight_steps, 1);
+        assert_eq!(c.failure_count, 1);
+    }
