+    #[test]
+    fn repeated_failures_double_backoff_up_to_frozen_schedule() {
+        let now = Instant::now();
+        let mut c = controller(BabrMode::Lite);
+        let mut loss = input(now);
+        loss.loss_detected = true;
+        c.on_round(loss);
+
+        let restart = now + Duration::from_secs(30);
+        assert_eq!(c.on_round(input(restart)).state, BabrLiteState::Assist);
+
+        let second_failure_time = restart + Duration::from_secs(1);
+        let mut pto = input(second_failure_time);
+        pto.pto_fired = true;
+        let failed = c.on_round(pto);
+        assert_eq!(failed.shadow_reason, BabrReasonCode::PtoFired);
+        assert_eq!(c.failure_count, 2);
+        assert_eq!(
+            c.backoff_deadline,
+            Some(second_failure_time + Duration::from_secs(60)),
+        );
+    }
