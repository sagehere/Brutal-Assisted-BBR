+    #[test]
+    fn babr_observe_snapshot_is_passive_and_starts_in_startup() {
+        const INIT_PACKET_SIZE: usize = 1200;
+        const INIT_WINDOW_PACKETS: usize = 10;
+        const MAX_WINDOW_PACKETS: usize = 10000;
+
+        let bbr2 = BBRv2::new(
+            INIT_WINDOW_PACKETS,
+            MAX_WINDOW_PACKETS,
+            INIT_PACKET_SIZE,
+            Duration::from_millis(100),
+            None,
+        );
+        let snapshot = bbr2.babr_observe_snapshot();
+
+        assert_eq!(snapshot.phase, BabrBbrPhase::Startup);
+        assert_eq!(snapshot.phase.as_str(), "Startup");
+        assert!(!snapshot.phase.assist_allowed());
+        assert!(!snapshot.end_of_round_trip);
+        assert_eq!(
+            snapshot.baseline_cwnd_bytes,
+            INIT_WINDOW_PACKETS * INIT_PACKET_SIZE
+        );
+        assert!(!snapshot.delivery_sample_valid);
+        assert!(!snapshot.loss_detected);
+    }
+
+    #[test]
+    fn babr_observe_phase_whitelist_matches_frozen_contract() {
+        assert!(BabrBbrPhase::ProbeBwRefill.assist_allowed());
+        assert!(BabrBbrPhase::ProbeBwUp.assist_allowed());
+        assert!(BabrBbrPhase::ProbeBwCruise.assist_allowed());
+
+        assert!(!BabrBbrPhase::Startup.assist_allowed());
+        assert!(!BabrBbrPhase::Drain.assist_allowed());
+        assert!(!BabrBbrPhase::ProbeBwDown.assist_allowed());
+        assert!(!BabrBbrPhase::ProbeRtt.assist_allowed());
+        assert!(!BabrBbrPhase::ProbeBwNotStarted.assist_allowed());
+        assert!(!BabrBbrPhase::Unknown.assist_allowed());
+    }
 }
