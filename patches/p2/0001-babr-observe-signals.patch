+                .babr_last_sample_max_bandwidth
+                .map(Bandwidth::to_bytes_per_second),
+            sample_min_rtt_micros: self.babr_last_sample_min_rtt.map(|rtt| {
+                rtt.as_micros().min(u64::MAX as u128) as u64
+            }),
+            sample_is_app_limited: self.last_sample_is_app_limited,
+            loss_detected: self.babr_last_loss_detected,
+        }
+    }
