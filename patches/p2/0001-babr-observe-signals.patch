+    pub(crate) fn babr_observe_snapshot(&self) -> BabrObserveSnapshot {
+        let phase = match &self.mode {
+            Mode::Startup(_) => BabrBbrPhase::Startup,
+            Mode::Drain(_) => BabrBbrPhase::Drain,
+            Mode::ProbeBW(probe_bw) => match probe_bw.cycle.phase {
+                CyclePhase::NotStarted => BabrBbrPhase::ProbeBwNotStarted,
+                CyclePhase::Up => BabrBbrPhase::ProbeBwUp,
+                CyclePhase::Down => BabrBbrPhase::ProbeBwDown,
+                CyclePhase::Cruise => BabrBbrPhase::ProbeBwCruise,
+                CyclePhase::Refill => BabrBbrPhase::ProbeBwRefill,
+            },
+            Mode::ProbeRTT(_) => BabrBbrPhase::ProbeRtt,
+            Mode::Placheolder(_) => BabrBbrPhase::Unknown,
+        };
+
+        BabrObserveSnapshot {
+            phase,
+            end_of_round_trip: self.babr_last_end_of_round_trip,
+            baseline_pacing_rate_bytes_per_second: self
+                .pacing_rate
+                .to_bytes_per_second(),
+            baseline_cwnd_bytes: self.cwnd,
+            model_delivery_rate_bytes_per_second: self
+                .mode
+                .network_model()
+                .bandwidth_estimate()
+                .to_bytes_per_second(),
+            delivery_sample_valid: self.babr_last_delivery_sample_valid,
