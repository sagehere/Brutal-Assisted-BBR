+/// Explicit BBRv2 phase exported only for BABR Observe telemetry.
+///
+/// This is intentionally independent from pacing gain so the BABR whitelist
+/// cannot infer a BBR phase from a numeric gain.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum BabrBbrPhase {
+    Startup,
+    Drain,
+    ProbeBwNotStarted,
+    ProbeBwUp,
+    ProbeBwDown,
+    ProbeBwCruise,
+    ProbeBwRefill,
+    ProbeRtt,
+    Unknown,
+}
+
+impl BabrBbrPhase {
+    pub(crate) const fn as_str(self) -> &'static str {
+        match self {
+            Self::Startup => "Startup",
+            Self::Drain => "Drain",
+            Self::ProbeBwNotStarted => "ProbeBW.NotStarted",
+            Self::ProbeBwUp => "ProbeBW.Up",
+            Self::ProbeBwDown => "ProbeBW.Down",
+            Self::ProbeBwCruise => "ProbeBW.Cruise",
+            Self::ProbeBwRefill => "ProbeBW.Refill",
+            Self::ProbeRtt => "ProbeRTT",
+            Self::Unknown => "Unknown",
+        }
+    }
+
+    /// Frozen p1-baseline-v3 assist phase whitelist.
+    pub(crate) const fn assist_allowed(self) -> bool {
+        matches!(
+            self,
+            Self::ProbeBwRefill | Self::ProbeBwUp | Self::ProbeBwCruise
+        )
+    }
+}
+
