+    /// Lite-only packet accounting path. The normal Off/Observe caller keeps
+    /// using `on_packet_sent()` unchanged. We first execute that exact path,
+    /// then replace only the release-time increment with the already-authorized
+    /// Lite rate. BBRv2, CWND, burst/lumpy tokens and send permission remain
+    /// owned by the baseline path.
+    pub(crate) fn on_packet_sent_with_babr_lite_rate(
+        &mut self, sent_time: Instant, bytes_in_flight: usize,
+        packet_number: u64, bytes: usize, is_retransmissible: bool,
+        requested_rate_bytes_per_second: u64, rtt_stats: &RttStats,
+    ) {
+        let prior_release_time = self.ideal_next_packet_send_time;
+
+        self.on_packet_sent(
+            sent_time,
+            bytes_in_flight,
+            packet_number,
+            bytes,
+            is_retransmissible,
+            rtt_stats,
+        );
+
+        if !self.enabled ||
+            !is_retransmissible ||
+            self.ideal_next_packet_send_time == ReleaseTime::Immediate
+        {
+            return;
+        }
+
+        let delay = self
+            .babr_lite_effective_pacing_rate(requested_rate_bytes_per_second)
+            .transfer_time(bytes as u64);
+
+        self.ideal_next_packet_send_time = prior_release_time;
+        self.ideal_next_packet_send_time.set_max(sent_time);
+        self.ideal_next_packet_send_time.inc(delay);
+    }
