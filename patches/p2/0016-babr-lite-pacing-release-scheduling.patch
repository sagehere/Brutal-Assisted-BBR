+    #[test]
+    fn babr_lite_rate_changes_only_release_schedule() {
+        let rtt = rtt_stats();
+        let mut baseline = Pacer::new(true, sender(), None);
+        let mut lite = Pacer::new(true, sender(), None);
+        baseline.burst_tokens = 0;
+        lite.burst_tokens = 0;
+
+        let now = Instant::now();
+        let bytes_in_flight = 24_000;
+        let bytes = 1_200;
+        let baseline_cwnd = baseline.get_congestion_window();
+        let baseline_rate = baseline
+            .pacing_rate(bytes_in_flight + bytes, &rtt)
+            .to_bytes_per_second();
+        let requested = baseline_rate.saturating_mul(11) / 10;
+
+        baseline.on_packet_sent(
+            now,
+            bytes_in_flight,
+            1,
+            bytes,
+            true,
+            &rtt,
+        );
+        lite.on_packet_sent_with_babr_lite_rate(
+            now,
+            bytes_in_flight,
+            1,
+            bytes,
+            true,
+            requested,
+            &rtt,
+        );
+
+        let baseline_release =
+            baseline.get_next_release_time().time(now).unwrap();
+        let lite_release = lite.get_next_release_time().time(now).unwrap();
+
+        assert!(lite_release < baseline_release);
+        assert_eq!(baseline.get_congestion_window(), baseline_cwnd);
+        assert_eq!(lite.get_congestion_window(), baseline_cwnd);
+    }
