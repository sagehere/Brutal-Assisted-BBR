+/// Transport/recovery events that can only make future BABR assistance more
+/// conservative. Observe records them; it never turns them into send control.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum BabrTransportGuardEvent {
+    LossDetected {
+        lost_bytes: usize,
+        lost_packets: usize,
+    },
+    PtoFired {
+        pto_count: u32,
+    },
+    AppLimited,
+    PathChanged {
+        path_id: u64,
+    },
+    ReceiverLimited,
+    PolicyLimited,
+}
+
+/// Monotonic Observe counters avoid dropping guard events between snapshots.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct BabrTransportGuardCounters {
+    pub(crate) loss_events: u64,
+    pub(crate) loss_bytes: u64,
+    pub(crate) loss_packets: u64,
+    pub(crate) pto_events: u64,
+    pub(crate) last_pto_count: u32,
+    pub(crate) app_limited_events: u64,
+    pub(crate) path_changed_events: u64,
+    pub(crate) last_path_id: Option<u64>,
+    pub(crate) receiver_limited_events: u64,
+    pub(crate) policy_limited_events: u64,
+}
+
+impl BabrTransportGuardCounters {
+    fn record(&mut self, event: BabrTransportGuardEvent) {
+        match event {
+            BabrTransportGuardEvent::LossDetected {
+                lost_bytes,
+                lost_packets,
+            } => {
+                self.loss_events = self.loss_events.saturating_add(1);
+                self.loss_bytes =
+                    self.loss_bytes.saturating_add(lost_bytes as u64);
+                self.loss_packets =
+                    self.loss_packets.saturating_add(lost_packets as u64);
+            },
+            BabrTransportGuardEvent::PtoFired { pto_count } => {
+                self.pto_events = self.pto_events.saturating_add(1);
+                self.last_pto_count = pto_count;
+            },
+            BabrTransportGuardEvent::AppLimited => {
+                self.app_limited_events =
+                    self.app_limited_events.saturating_add(1);
+            },
+            BabrTransportGuardEvent::PathChanged { path_id } => {
+                self.path_changed_events =
+                    self.path_changed_events.saturating_add(1);
+                self.last_path_id = Some(path_id);
+            },
+            BabrTransportGuardEvent::ReceiverLimited => {
+                self.receiver_limited_events =
+                    self.receiver_limited_events.saturating_add(1);
+            },
+            BabrTransportGuardEvent::PolicyLimited => {
+                self.policy_limited_events =
+                    self.policy_limited_events.saturating_add(1);
+            },
+        }
+    }
+}
+
+/// Accounting names are intentionally non-overlapping.
+///
+/// `recovery_packet_bytes_sent` is not socket-success accounting, and
+/// `transport_acked_bytes` is not unique-payload goodput. The two metrics
+/// that require later bridges stay `None` until those bridges exist.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct BabrObserveAccounting {
+    pub(crate) model_delivery_rate_bytes_per_second: u64,
+    pub(crate) recovery_packet_bytes_sent: u64,
+    pub(crate) transport_acked_bytes: u64,
+    pub(crate) transport_lost_bytes: u64,
+    pub(crate) unique_payload_delivered_bytes: Option<u64>,
+    pub(crate) actual_socket_sent_bytes: Option<u64>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct BabrRecoveryObserveSnapshot {
+    pub(crate) bbr: BabrObserveSnapshot,
+    pub(crate) guards: BabrTransportGuardCounters,
+    pub(crate) accounting: BabrObserveAccounting,
+}
