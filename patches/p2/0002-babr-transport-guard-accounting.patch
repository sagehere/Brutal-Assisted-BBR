+    pub(crate) fn babr_observe_snapshot(&self) -> BabrRecoveryObserveSnapshot {
+        let bbr = self.pacer.babr_observe_snapshot();
+        let accounting = BabrObserveAccounting {
+            model_delivery_rate_bytes_per_second:
+                bbr.model_delivery_rate_bytes_per_second,
+            recovery_packet_bytes_sent: self.bytes_sent as u64,
+            transport_acked_bytes: self.babr_transport_acked_bytes,
+            transport_lost_bytes: self.babr_guard_counters.loss_bytes,
+            unique_payload_delivered_bytes: None,
+            actual_socket_sent_bytes: None,
+        };
+
+        BabrRecoveryObserveSnapshot {
+            bbr,
+            guards: self.babr_guard_counters,
+            accounting,
+        }
     }
 
+    /// Path identity must come from the connection/path layer. Recovery does
