+    #[test]
+    fn babr_observe_accounting_keeps_unavailable_metrics_unknown() {
+        let r = new_babr_recovery();
+        let snapshot = r.babr_observe_snapshot();
+
+        assert_eq!(snapshot.accounting.recovery_packet_bytes_sent, 0);
+        assert_eq!(snapshot.accounting.transport_acked_bytes, 0);
+        assert_eq!(snapshot.accounting.transport_lost_bytes, 0);
+        assert_eq!(snapshot.accounting.unique_payload_delivered_bytes, None);
+        assert_eq!(snapshot.accounting.actual_socket_sent_bytes, None);
+    }
+
+    #[test]
+    fn babr_external_guard_sources_are_explicit() {
+        let mut r = new_babr_recovery();
+        r.babr_on_path_changed(7);
+        r.babr_on_receiver_limited();
+        r.babr_on_policy_limited();
+        let guards = r.babr_observe_snapshot().guards;
+
+        assert_eq!(guards.path_changed_events, 1);
+        assert_eq!(guards.last_path_id, Some(7));
+        assert_eq!(guards.receiver_limited_events, 1);
+        assert_eq!(guards.policy_limited_events, 1);
+    }
