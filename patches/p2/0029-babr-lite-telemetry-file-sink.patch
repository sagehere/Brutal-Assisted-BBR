+    fn babr_lite_enable_from_env(
+        &mut self, qconn: &mut QuicheConnection,
+    ) -> QuicResult<()> {
+        let Some(path) = std::env::var_os("BABR_P2_LITE_TELEMETRY_FILE") else {
+            return Ok(());
+        };
+
+        let Some((from, to)) = qconn
+            .path_stats()
+            .find(|stats| stats.active)
+            .map(|stats| (stats.local_addr, stats.peer_addr))
+        else {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                "BABR Lite telemetry requested but no active QUIC path exists",
+            )
+            .into());
+        };
+
+        let sink = OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .open(path)?;
+
+        qconn.babr_set_lite_telemetry_enabled(from, to, true)?;
+        self.babr_lite_sink = Some(sink);
+        self.babr_lite_path = Some((from, to));
+        self.babr_lite_next_drain =
+            Some(Instant::now() + BABR_OBSERVE_DRAIN_INTERVAL);
+        Ok(())
+    }
+
+    fn babr_lite_drain(
+        &mut self, qconn: &mut QuicheConnection, force: bool,
+    ) -> QuicResult<()> {
+        let Some((from, to)) = self.babr_lite_path else {
+            return Ok(());
+        };
+
+        let now = Instant::now();
+        if !force {
+            if let Some(next) = self.babr_lite_next_drain {
+                if now < next {
+                    return Ok(());
+                }
+            }
+            self.babr_lite_next_drain =
+                Some(now + BABR_OBSERVE_DRAIN_INTERVAL);
+        }
+
+        let lines = qconn.babr_take_lite_telemetry_json_lines(from, to)?;
+        if lines.is_empty() {
+            return Ok(());
+        }
+
+        let Some(sink) = self.babr_lite_sink.as_mut() else {
+            return Ok(());
+        };
+        let mut batch = String::new();
+        for line in lines {
+            batch.push_str(&line);
+            batch.push('\n');
+        }
+        sink.write_all(batch.as_bytes())?;
+        Ok(())
+    }
+
