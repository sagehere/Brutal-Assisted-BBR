+impl<H: DriverHooks> H3Driver<H> {
+    fn babr_observe_enable_from_env(
+        &mut self, qconn: &mut QuicheConnection,
+    ) -> QuicResult<()> {
+        let Some(path) = std::env::var_os("BABR_OBSERVE_TELEMETRY_FILE") else {
+            return Ok(());
+        };
+
+        let Some((from, to)) = qconn
+            .path_stats()
+            .find(|stats| stats.active)
+            .map(|stats| (stats.local_addr, stats.peer_addr))
+        else {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                "BABR Observe requested but no active QUIC path exists",
+            )
+            .into());
+        };
+
+        let sink = OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .open(path)?;
+
+        qconn.babr_set_observe_telemetry_enabled(from, to, true)?;
+        self.babr_observe_sink = Some(sink);
+        self.babr_observe_path = Some((from, to));
+
+        Ok(())
+    }
+
+    fn babr_observe_drain(
+        &mut self, qconn: &mut QuicheConnection,
+    ) -> QuicResult<()> {
+        let Some((from, to)) = self.babr_observe_path else {
+            return Ok(());
+        };
+
+        let lines = qconn.babr_take_observe_telemetry_json_lines(from, to)?;
+        if lines.is_empty() {
+            return Ok(());
+        }
+
+        let Some(sink) = self.babr_observe_sink.as_mut() else {
+            return Ok(());
+        };
+
+        // One write per drain keeps the experiment's filesystem overhead
+        // measurable without issuing one syscall for every telemetry record.
+        let mut batch = String::new();
+        for line in lines {
+            batch.push_str(&line);
+            batch.push('\n');
+        }
+        sink.write_all(batch.as_bytes())?;
+
+        Ok(())
+    }
+}
