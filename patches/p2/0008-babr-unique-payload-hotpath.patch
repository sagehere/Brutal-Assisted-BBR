+    /// Returns how many bytes in `item` are already covered by this set.
+    ///
+    /// BABR Observe uses this to count only newly acknowledged STREAM payload
+    /// without rescanning the complete ACK history on every ACK. Inline sets
+    /// are tiny; BTree sets use one predecessor lookup plus only ranges whose
+    /// starts fall inside the queried interval.
+    pub(crate) fn babr_covered_bytes(&self, item: Range<u64>) -> u64 {
+        let start = item.start;
+        let end = item.end;
+        if start >= end {
+            return 0;
+        }
+
+        match self {
+            RangeSet::Inline(set) => {
+                let mut covered = 0_u64;
+                for &(s, e) in &set.inner {
+                    if s >= end {
+                        break;
+                    }
+                    let lo = cmp::max(s, start);
+                    let hi = cmp::min(e, end);
+                    if hi > lo {
+                        covered = covered.saturating_add(hi - lo);
+                    }
+                }
+                covered
+            },
+
+            RangeSet::BTree(set) => {
+                let mut covered = 0_u64;
+                if let Some((&s, &e)) = set.inner.range(..start).next_back() {
+                    let hi = cmp::min(e, end);
+                    if hi > start {
+                        covered = covered.saturating_add(hi - start);
+                    }
+                    debug_assert!(s < start);
+                }
+
+                for (&s, &e) in set.inner.range(start..end) {
+                    let hi = cmp::min(e, end);
+                    if hi > s {
+                        covered = covered.saturating_add(hi - s);
+                    }
+                }
+                covered
+            },
+        }
+    }
+
