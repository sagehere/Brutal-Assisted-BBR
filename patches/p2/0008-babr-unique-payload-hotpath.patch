+    /// Bytes in this ACK range that have not already been acknowledged.
+    pub(crate) fn babr_newly_acked_payload_bytes(
+        &self, off: u64, len: usize,
+    ) -> u64 {
+        let end = off + len as u64;
+        (end - off).saturating_sub(self.acked.babr_covered_bytes(off..end))
