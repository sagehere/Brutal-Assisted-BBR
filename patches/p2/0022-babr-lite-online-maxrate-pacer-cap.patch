+    pub(crate) fn babr_lite_effective_pacing_rate(
+        &self, requested_rate_bytes_per_second: u64,
+    ) -> Bandwidth {
+        let requested =
+            Bandwidth::from_bytes_per_second(requested_rate_bytes_per_second);
+
+        match self.effective_rate_cap() {
+            Some(rate) if self.enabled => rate.min(requested),
+            _ => requested,
+        }
+    }
+
+    fn effective_rate_cap(&self) -> Option<Bandwidth> {
+        match (self.max_pacing_rate, self.babr_policy_rate_cap) {
+            (Some(host), Some(policy)) => Some(host.min(policy)),
+            (Some(host), None) => Some(host),
+            (None, Some(policy)) => Some(policy),
+            (None, None) => None,
+        }
+    }
+
+    pub(crate) fn babr_set_policy_rate_cap_bytes_per_second(
+        &mut self, max_rate: Option<u64>,
+    ) {
+        self.babr_policy_rate_cap =
+            max_rate.map(Bandwidth::from_bytes_per_second);
+    }
 
