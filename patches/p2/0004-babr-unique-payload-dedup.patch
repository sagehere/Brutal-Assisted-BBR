+/// Connection-scoped accounting of uniquely acknowledged STREAM payload.
+///
+/// Packet ACK bytes are intentionally not used because retransmissions can
+/// acknowledge the same application byte range more than once. Keeping the
+/// ledger at connection scope also prevents a path migration from resetting
+/// deduplication state.
+#[derive(Default)]
+struct BabrUniquePayloadTracker {
+    stream_ranges: BTreeMap<u64, ranges::RangeSet>,
+    total_bytes: u64,
+}
+
+impl BabrUniquePayloadTracker {
+    fn observe_stream_range(
+        &mut self, stream_id: u64, offset: u64, length: usize,
+    ) -> u64 {
+        if length == 0 {
+            return 0;
+        }
+
+        let end = offset.saturating_add(length as u64);
+        let ranges = self
+            .stream_ranges
+            .entry(stream_id)
+            .or_insert_with(|| ranges::RangeSet::new(usize::MAX));
+
+        let before = ranges
+            .iter()
+            .fold(0_u64, |n, r| n.saturating_add(r.end - r.start));
+        ranges.insert(offset..end);
+        let after = ranges
+            .iter()
+            .fold(0_u64, |n, r| n.saturating_add(r.end - r.start));
+        let delta = after.saturating_sub(before);
+
+        self.total_bytes = self.total_bytes.saturating_add(delta);
+        delta
+    }
+
+    fn total_bytes(&self) -> u64 {
+        self.total_bytes
+    }
+}
+
+#[cfg(test)]
+mod babr_p2_unique_payload_tests {
+    use super::BabrUniquePayloadTracker;
+
+    #[test]
+    fn l06_retransmission_and_late_duplicate_count_payload_once() {
+        let mut tracker = BabrUniquePayloadTracker::default();
+
+        // First successful delivery of bytes [0, 4).
+        assert_eq!(tracker.observe_stream_range(4, 0, 4), 4);
+
+        // Retransmission or late original ACK of the same bytes.
+        assert_eq!(tracker.observe_stream_range(4, 0, 4), 0);
+
+        // Partial overlap only contributes previously unseen bytes [4, 6).
+        assert_eq!(tracker.observe_stream_range(4, 2, 4), 2);
+
+        // The same offsets on another stream are distinct payload.
+        assert_eq!(tracker.observe_stream_range(8, 0, 4), 4);
+
+        assert_eq!(tracker.total_bytes(), 10);
+    }
+}
