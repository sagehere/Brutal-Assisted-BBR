+    fn babr_record_lite_decision(
+        &mut self, now: Instant, snapshot: BabrRecoveryObserveSnapshot,
+        decision: BabrLiteDecision,
+    ) {
+        if !self.babr_lite_telemetry.enabled() {
+            return;
+        }
+
+        let input = BabrLiteTelemetryInput {
+            now,
+            phase: snapshot.bbr.phase,
+            baseline_pacing_rate_bytes_per_second:
+                snapshot.bbr.baseline_pacing_rate_bytes_per_second,
+            baseline_cwnd_bytes: snapshot.bbr.baseline_cwnd_bytes,
+            model_delivery_rate_bytes_per_second:
+                snapshot.bbr.model_delivery_rate_bytes_per_second,
+            unique_payload_delivered_bytes:
+                snapshot.accounting.unique_payload_delivered_bytes,
+            actual_socket_sent_bytes:
+                snapshot.accounting.actual_socket_sent_bytes,
+            decision,
+            controller: self.babr_lite_controller.trace_snapshot(),
+        };
+        self.babr_lite_telemetry.record_if_changed(input);
+    }
+
+    fn babr_record_lite_reason(
+        &mut self, now: Instant, reason: BabrReasonCode,
+    ) {
+        if !self.babr_lite_telemetry.enabled() {
+            return;
+        }
+
+        let snapshot = self.babr_observe_snapshot();
+        let controller = self.babr_lite_controller.trace_snapshot();
+        let baseline = snapshot.bbr.baseline_pacing_rate_bytes_per_second;
+        let decision = BabrLiteDecision {
+            state: controller.state,
+            reason,
+            shadow_reason: reason,
+            weight_steps: controller.weight_steps,
+            candidate_pacing_rate_bytes_per_second: baseline,
+            final_pacing_rate_bytes_per_second: baseline,
+            final_cwnd_bytes: snapshot.bbr.baseline_cwnd_bytes,
+            control_applied: false,
+            soft_guard: false,
+            hard_guard: false,
+        };
+        self.babr_record_lite_decision(now, snapshot, decision);
+    }
