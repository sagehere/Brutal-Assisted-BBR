+    /// Enable or disable BABR Lite control telemetry for one real path.
+    #[doc(hidden)]
+    pub fn babr_set_lite_telemetry_enabled(
+        &mut self, from: SocketAddr, to: SocketAddr, enabled: bool,
+    ) -> Result<()> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        if enabled {
+            // Lite telemetry has one bounded ring per selected connection.
+            for (_, path) in self.paths.iter_mut() {
+                path.recovery.babr_set_lite_telemetry_enabled(false);
+            }
+        }
+
+        self.paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_set_lite_telemetry_enabled(enabled);
+        Ok(())
+    }
+
+    /// Drain BABR Lite control telemetry as newline-delimited JSON records.
+    #[doc(hidden)]
+    pub fn babr_take_lite_telemetry_json_lines(
+        &mut self, from: SocketAddr, to: SocketAddr,
+    ) -> Result<Vec<String>> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        Ok(self
+            .paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_take_lite_telemetry_json_lines(Instant::now()))
+    }
