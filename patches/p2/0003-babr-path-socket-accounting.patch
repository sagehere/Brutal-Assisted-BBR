+    /// BABR Observe-only hook for the actual socket/GSO success boundary.
+    ///
+    /// `bytes` must be exactly the successful socket return value. This
+    /// method never changes pacing, CWND, send permission, or recovery.
+    #[doc(hidden)]
+    pub fn babr_on_socket_sent(
+        &mut self, from: SocketAddr, to: SocketAddr, bytes: usize,
+    ) -> Result<()> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        self.paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_on_socket_sent(bytes);
+        Ok(())
+    }
