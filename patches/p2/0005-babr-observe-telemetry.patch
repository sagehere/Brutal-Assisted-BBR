+    /// Enable or disable BABR Observe telemetry for one real path.
+    #[doc(hidden)]
+    pub fn babr_set_observe_telemetry_enabled(
+        &mut self, from: SocketAddr, to: SocketAddr, enabled: bool,
+    ) -> Result<()> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        if enabled {
+            // The frozen budget is per connection, not per path. Release any
+            // prior path ring before enabling the selected real path.
+            for (_, path) in self.paths.iter_mut() {
+                path.recovery
+                    .babr_set_observe_telemetry_enabled(false);
+            }
+        }
+
+        self.paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_set_observe_telemetry_enabled(enabled);
+        Ok(())
+    }
+
+    /// Drain BABR Observe telemetry as newline-delimited JSON records.
+    ///
+    /// The recovery-side serializer enforces the frozen 1 MiB/min budget.
+    #[doc(hidden)]
+    pub fn babr_take_observe_telemetry_json_lines(
+        &mut self, from: SocketAddr, to: SocketAddr,
+    ) -> Result<Vec<String>> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        Ok(self
+            .paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_take_observe_telemetry_json_lines(Instant::now()))
+    }
