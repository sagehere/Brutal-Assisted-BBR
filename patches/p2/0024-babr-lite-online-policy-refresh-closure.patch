     #[test]
+    fn babr_lite_policy_refresh_override_does_not_advance_round_clock() {
+        let mut r = new_babr_recovery();
+        assert!(r.babr_set_lite_target_bytes_per_second(26_000_000));
+        r.babr_set_lite_mode(BabrMode::Lite);
+
+        let now = Instant::now();
+        let input = BabrLiteInput {
+            now,
+            phase: super::super::bbr2::BabrBbrPhase::ProbeBwCruise,
+            end_of_round_trip: true,
+            baseline_pacing_rate_bytes_per_second: 20_000_000,
+            baseline_cwnd_bytes: 64_000,
+            model_delivery_rate_bytes_per_second: 20_000_000,
+            sample_valid: true,
+            sample_age_rounds: 0,
+            srtt: Duration::from_millis(50),
+            min_rtt: Duration::from_millis(50),
+            path_changed: false,
+            app_limited: false,
+            receiver_limited: false,
+            policy_limited: false,
+            loss_detected: false,
+            pto_fired: false,
+        };
+
+        let first =
+            r.babr_lite_decide_input_with_round_override(input, true);
+        assert_eq!(first.weight_steps, 0);
+        assert!(!first.control_applied);
+        let deadline = r.babr_lite_deadline();
+        assert!(deadline.is_some());
+
+        let second = r.babr_lite_decide_input_with_round_override(
+            BabrLiteInput {
+                now: now + Duration::from_millis(1),
+                ..input
+            },
+            true,
+        );
+        assert_eq!(second.weight_steps, 0);
+        assert!(!second.control_applied);
+        assert_eq!(r.babr_lite_deadline(), deadline);
+
+        let real_round = r.babr_lite_decide_input_with_round_override(
+            BabrLiteInput {
+                now: now + Duration::from_millis(2),
+                ..input
+            },
+            false,
+        );
+        assert_eq!(real_round.weight_steps, 1);
+        assert!(real_round.control_applied);
+        assert_eq!(r.babr_lite_deadline(), deadline);
+    }
