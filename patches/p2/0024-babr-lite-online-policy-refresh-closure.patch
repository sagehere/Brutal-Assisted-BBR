+        r.babr_set_lite_mode(BabrMode::Lite);
+
+        let decision = r.babr_lite_decide_input_with_round_override(
+            BabrLiteInput {
+                now: Instant::now(),
+                phase: super::super::bbr2::BabrBbrPhase::ProbeBwCruise,
+                end_of_round_trip: true,
