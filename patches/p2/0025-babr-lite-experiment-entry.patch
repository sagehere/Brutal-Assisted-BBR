 const BABR_OBSERVE_DRAIN_INTERVAL: Duration = Duration::from_millis(250);
 
 impl<H: DriverHooks> H3Driver<H> {
+    fn babr_experiment_configure_from_env(
+        &mut self, qconn: &mut QuicheConnection,
+    ) -> QuicResult<()> {
+        let Some(mode) = std::env::var_os("BABR_P2_MODE") else {
+            // Absence is the normal production/default path: BABR remains Off.
+            return Ok(());
+        };
+        let mode = mode
+            .to_str()
+            .ok_or_else(|| {
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "BABR_P2_MODE is not valid UTF-8",
+                )
+            })?
+            .to_ascii_lowercase();
+
+        let target_text =
+            std::env::var("BABR_P2_TARGET_BPS").unwrap_or_else(|_| "0".into());
+        let target = target_text.parse::<u64>().map_err(|_| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "BABR_P2_TARGET_BPS must be an unsigned byte/s value",
+            )
+        })?;
+
+        let max_rate = match std::env::var("BABR_P2_MAX_RATE_BPS") {
+            Ok(v) => {
+                let parsed = v.parse::<u64>().map_err(|_| {
+                    std::io::Error::new(
+                        std::io::ErrorKind::InvalidInput,
+                        "BABR_P2_MAX_RATE_BPS must be an unsigned byte/s value",
+                    )
+                })?;
+                (parsed != 0).then_some(parsed)
+            },
+            Err(std::env::VarError::NotPresent) => None,
+            Err(_) => {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "BABR_P2_MAX_RATE_BPS is not valid UTF-8",
+                )
+                .into());
+            },
+        };
+
+        let Some((from, to)) = qconn
+            .path_stats()
+            .find(|stats| stats.active)
+            .map(|stats| (stats.local_addr, stats.peer_addr))
+        else {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                "BABR P2 experiment requested but no active QUIC path exists",
+            )
+            .into());
+        };
+
+        qconn.babr_configure_experiment(
+            from,
+            to,
+            mode.as_str(),
+            target,
+            max_rate,
+        )?;
+        log::info!(
+            "BABR P2 experiment configured";
+            "mode" => mode,
+            "target_Bps" => target,
+            "max_rate_Bps" => max_rate.unwrap_or(0)
+        );
+        Ok(())
+    }
