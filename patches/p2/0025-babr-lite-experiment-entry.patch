+    pub(crate) fn babr_configure_experiment(
+        &mut self, mode: &str, target: u64, max_rate: Option<u64>,
+    ) -> bool {
+        let mode = match mode {
+            "off" => BabrMode::Off,
+            "observe" => BabrMode::Observe,
+            "lite" => BabrMode::Lite,
+            _ => return false,
+        };
+
+        // P2 experiment entry is fail-closed. Lite must never be enabled with
+        // an implicit/zero Target, while Off/Observe may intentionally use 0.
+        if mode == BabrMode::Lite && target == 0 {
+            return false;
+        }
+        if !self.babr_set_lite_target_bytes_per_second(target) {
+            return false;
+        }
+
+        self.babr_set_lite_max_rate_bytes_per_second(max_rate);
+        self.babr_set_lite_mode(mode);
+        true
+    }
