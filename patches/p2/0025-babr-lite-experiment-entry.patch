+    /// Configure the P2 BABR experiment on one real path.
+    ///
+    /// This hidden entry exists only for the controlled P2 harness. Normal
+    /// applications remain Off unless they call it explicitly.
+    #[doc(hidden)]
+    pub fn babr_configure_experiment(
+        &mut self, from: SocketAddr, to: SocketAddr, mode: &str, target: u64,
+        max_rate: Option<u64>,
+    ) -> Result<()> {
+        let path_id = self
+            .paths
+            .path_id_from_addrs(&(from, to))
+            .ok_or(Error::InvalidState)?;
+
+        let configured = self
+            .paths
+            .get_mut(path_id)?
+            .recovery
+            .babr_configure_experiment(mode, target, max_rate);
+        if !configured {
+            return Err(Error::InvalidState);
+        }
+
+        Ok(())
+    }
